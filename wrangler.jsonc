{
	"name": "paysdoc-nl",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-04-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Zone routes make the Worker answer for the real site; DNS already points
	// both hosts at Cloudflare, so no DNS change is needed. The apex is
	// redirected to www by next.config.ts.
	"routes": [
		{ "pattern": "www.paysdoc.nl/*", "zone_name": "paysdoc.nl" },
		{ "pattern": "paysdoc.nl/*", "zone_name": "paysdoc.nl" }
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "paysdoc-nl"
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"COST_API_URL": "https://costs.paysdoc.nl",
		"EMAIL_WORKER_URL": "https://email.paysdoc.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "paysdoc-auth-db",
			"database_id": "138b4abc-dc32-4f08-98a7-87442977a5d3"
		}
	],
	"kv_namespaces": [
		// id is created and filled in by Phase 02 via the cloudflare-ops workflow
		{
			"binding": "INTEREST_KV",
			"id": "<placeholder>"
		}
	]
}
